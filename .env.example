# Diggame infrastructure settings
#
# The NUMBER side of the game does not live here. Every rule - the pit's size
# and odds, digging times, gate and boss maths, battle numbers, weapons, skills -
# is in config/game.json, which is required and checked strictly at boot. This
# file is only for the machine: where to listen, where the database lives,
# secrets, and tick rates.
#
# Every value here is OPTIONAL. The defaults live in server/config.js and the
# game boots with them if this file is missing. Copy to `.env` to override:
#
#   cp .env.example .env
#
# Rules:
#   - a real environment variable always wins over this file
#   - a value that is not a number / boolean, or is out of range, is ignored
#     with a warning on startup and the default is used instead
#   - a bare `KEY=` means "use the default"
#   - unlike the rules file, a bad value here never stops the server

# ---------- server ----------
PORT=3000
HOST=0.0.0.0
# relative paths are resolved from the project root
DB_PATH=data/diggame.db
# Path to the rules file. It is a path, not a rule, so it stays here. A missing
# or malformed file IS fatal: the server refuses to start without its rules.
GAME_CONFIG=config/game.json
# Leave empty to disable the HTTP reset endpoint. `npm run reset` always works.
RESET_SECRET=
# Secret for the admin spectator view. Leave EMPTY to disable it: with no secret
# set, nobody - not even a logged-in player - can be shown the field, so a server
# that never opts in cannot leak it. It is never sent to a browser.
ADMIN_SECRET=
# Default depth margin for the admin view: how many cells below the deepest cell
# anybody has dug the view reaches. An admin can lower or raise it per session
# between 0 and this ceiling.
ADMIN_VIEW_MARGIN=30
# How long a halted game keeps showing its "server error" screen before exiting.
HALT_EXIT_DELAY_MS=3000

# ---------- world ----------
# Pin the world seed for reproducible worlds. Empty = a new random seed per game,
# recorded in the worlds table so old runs stay identifiable.
WORLD_SEED=

# ---------- rates ----------
# Server tick: resolves finished digs, expiry timers and the broadcast.
TICK_HZ=10
# Spectator frames per second.
SPECTATOR_HZ=4
# How often stats are handed to the database. Deltas, so this is safe to make short.
STATS_FLUSH_MS=500
